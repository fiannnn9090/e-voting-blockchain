{
    "name": "e-voting-blockchain",
    "version": "1.0.0",
    "description": "",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "jest --runInBand",
        "test:coverage": "jest --coverage --runInBand"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
  "jest": {
    "setupFilesAfterEnv": ["<rootDir>/tests/jest.setup.js"],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "blockchain/**/*.js",
      "services/votingService.js",
      "services/auditLogService.js",
      "services/candidateLedgerService.js",
      "services/candidateProjectionService.js",
      "services/authService.js",
      "config/db.js",
      "controllers/auditLedgerController.js",
      "controllers/auditLogController.js",
      "controllers/explorerController.js",
      "blockchain/merkle.js",
      "blockchain/keys.js",
      "utils/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 70,
        "functions": 80,
        "lines": 80
      }
    }
  },

    "dependencies": {
        "bcryptjs": "^2.4.3",
        "body-parser": "^2.2.0",
        "cors": "^2.8.5",
        "crypto-js": "^4.2.0",
        "exceljs": "^4.4.0",
        "express": "^5.1.0",
        "express-mysql-session": "^3.0.3",
        "express-rate-limit": "^7.5.1",
        "express-session": "^1.19.0",
        "mysql2": "^3.15.1",
        "pdfkit": "^0.15.2"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "nodemon": "^3.1.14",
        "supertest": "^6.3.3"
    }
}